{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler", // 수정: node -> bundler
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "allowImportingTsExtensions": true // 이거 사용하려면 noEmit 설정을 true로 잡아주어야 함
  },
  "include": ["vite.config.ts"]
}